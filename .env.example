# Server-only Vercel environment variables. Never prefix these with VITE_.
# Leave empty until a verified sending domain/provider and Redis are configured.
CONTACT_ORIGIN=
CONTACT_FROM=
CONTACT_TO=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters, used to hash rate keys and idempotency keys.
CONTACT_RATE_SECRET=

# Local Vite server only: hide automatic pause when losing window focus.
# Explicit Escape pause still works; movement stays stopped until user input.
DEV_MODE=false
